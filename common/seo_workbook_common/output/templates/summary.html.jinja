<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>{{ session.client }} — SEO Plan — {{ session.month }}</title>
<style>
  body { font-family: Helvetica, Arial, sans-serif; font-size: 11px; color: #1a1a1a; }
  h1 { font-size: 20px; margin-bottom: 0; }
  .meta { color: #555; margin-top: 4px; margin-bottom: 24px; }
  .status { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 10px; text-transform: uppercase; }
  .status.draft { background: #fde68a; color: #7c5a00; }
  .status.finalized { background: #bbf7d0; color: #14532d; }
  .page { margin-bottom: 20px; page-break-inside: avoid; border: 1px solid #ddd; border-radius: 6px; padding: 12px 16px; }
  .page h2 { font-size: 14px; margin: 0 0 4px 0; word-break: break-all; }
  .page .targeting { color: #555; margin-bottom: 8px; }
  table { width: 100%; border-collapse: collapse; margin-top: 6px; }
  th, td { text-align: left; padding: 4px 6px; border-bottom: 1px solid #eee; vertical-align: top; }
  th { background: #f5f5f5; font-size: 10px; text-transform: uppercase; color: #555; }
  .item-list { margin: 0; padding-left: 16px; }
  .fail { color: #b91c1c; }
  .pass { color: #15803d; }
  footer { margin-top: 24px; color: #999; font-size: 9px; }
</style>
</head>
<body>
  <h1>{{ session.client }} — SEO Optimization Plan</h1>
  <div class="meta">
    {{ session.month }}
    · <span class="status {{ session.status.value }}">{{ session.status.value }}</span>
    {% if session.requested_by %}· requested by {{ session.requested_by }}{% endif %}
  </div>

  {% for page in session.pages %}
  <div class="page">
    <h2>{{ page.url }}</h2>
    <div class="targeting">
      {% if page.keyword_target %}
        Keyword: <strong>{{ page.keyword_target.keyword }}</strong>{% if page.keyword_target.search_volume %} (vol. {{ page.keyword_target.search_volume }}){% endif %}
      {% endif %}
      {% if page.geo %} · Geo: <strong>{{ page.geo }}</strong>{% endif %}
    </div>

    {% if page.touchpoints %}
    <table>
      <thead>
        <tr><th>Category</th><th>Touchpoint</th><th>Details</th><th>Status</th></tr>
      </thead>
      <tbody>
        {% for tp in page.touchpoints %}
        <tr>
          <td>{{ tp.category }}</td>
          <td>{{ touchpoint_name(tp.touchpoint_id) }}</td>
          <td>
            <ul class="item-list">
              {% for item in tp.items %}
              <li>{{ item | format_item(tp.touchpoint_id) }}</li>
              {% endfor %}
            </ul>
          </td>
          <td class="{{ 'pass' if tp.validation.passed else 'fail' }}">
            {{ "Passed" if tp.validation.passed else tp.validation.messages | join("; ") }}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
      <p><em>No optimizations recorded yet.</em></p>
    {% endif %}
  </div>
  {% endfor %}

  <footer>
    Generated from session {{ session.session_id }} · created {{ session.created_at }}
    {%- if session.finalized_at %} · finalized {{ session.finalized_at }}{% endif %}
  </footer>
</body>
</html>
